{
  "name": "bitcoin-whitepaper-explainer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "An interactive, bilingual walkthrough of the Bitcoin whitepaper. Provided by Animus Laboratories.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "fetch-reference": "node scripts/fetch-reference.mjs"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/noto-sans-hk": "^5.3.1",
    "@fontsource/noto-serif-hk": "^5.3.1",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@remixicon/react": "^4.9.0",
    "@scure/base": "^2.4.0",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^27.0.1",
    "playwright-core": "^1.65.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^3.2.7"
  }
}
